<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class ConfiguracaoGeralInteligenciaArtificial extends Model
{
    use HasFactory;

    protected $table = 'prompt_ia';

    protected $fillable = [
        'prompt',
        'instrucao',
        'saida',
        'empresa',
        'identificador'
    ];


    public static function criarPrompt(array $dados, $user = null)
    {
        return self::create([
            'prompt'        => $dados['prompt'] ?? null,
            'instrucao'     => $dados['instrucao'] ?? null,
            'saida'         => $dados['saida'] ?? null,
            'empresa'       => $dados['empresa'] ?? null,
            'identificador' => $dados['identificador'] ?? null,
        ]);
    }


    public static function AtualizarPrompt(array $dados, $user = null)
    {

        $prompt = null;

        if (!empty($dados['id'])) {
            $prompt = self::find($dados['id']);
        } elseif (!empty($dados['identificador'])) {
            $prompt = self::where('identificador', $dados['identificador'])->first();
        }

        if (!$prompt) {
            return false;
        }

        $prompt->update(array_filter([
            'prompt'        => $dados['prompt'] ?? null,
            'instrucao'     => $dados['instrucao'] ?? null,
            'saida'         => $dados['saida'] ?? null,
            'empresa'       => $dados['empresa'] ?? null,
            'identificador' => $dados['identificador'] ?? null,
        ], fn($value) => !is_null($value)));

        return $prompt;
    }


    public static function ExcluirPrompt(array $dados, $user = null)
    {
        if (!empty($dados['id'])) {
            return self::destroy($dados['id']);
        }

        if (!empty($dados['identificador'])) {
            return self::where('identificador', $dados['identificador'])->delete();
        }

        return false;
    }
}


